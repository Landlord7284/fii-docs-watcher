# Deployment parameters for docker compose.
#
# The robot's own settings are NOT here -- they live in config.toml, which is
# mounted into the container, and which is the same file a native install uses.
# Copy config.example.toml to config.toml next to this file and edit that.
#
# Any single setting can still be overridden from here without touching the
# file, as FII_WATCHER_<SECTION>_<KEY>; see the bottom of this file for the one
# worth knowing about.

# ---------------------------------------------------------------- the image --

# Pin a release rather than tracking latest if you want updates to be a
# deliberate act: IMAGE_TAG=0.4.0
IMAGE_TAG=latest

# --------------------------------------------------------------- the archive --

# Where the archive lands on the host. This is the directory to share; the
# private state goes in a named volume instead and needs nothing from you.
DOCUMENTS_PATH=./documents

# The uid and gid that own what the robot writes. Set these to whatever needs
# to read the share.
PUID=1000
PGID=1000

# -------------------------------------------------------------- the schedules --

# There are two run profiles, and a schedule for each. Schedules live here;
# how many days each profile covers lives in [discovery] in config.toml. They
# answer different questions -- how often to look, and how far back -- so a
# change of cadence must not read like a change of coverage.
#
# Both are standard 5-field cron expressions, evaluated in the source's
# timezone -- the same one the archive is dated by, from [source].timezone --
# so a time here means what a directory name means. Five fields, not the
# six-field form whose first is seconds: sub-minute scheduling means nothing
# for a job in which one HTTP request can take a minute on its own.
#
#   30 8 * * *      once, at 08:30
#   0 8,18 * * 1-5  twice a day, weekdays only
#   0 */4 * * *     every four hours

# The monitor: hourly through the publishing day, covering
# [discovery].monitor_days (2) and skipping the global audit.
MONITOR_SCHEDULE=0 7-23 * * *
MONITOR_ENABLED=true

# The full sweep: once a day and early, covering [discovery].days (7) and
# running the audit -- the global-listing cross-check that asks whether a
# document belonging to a monitored fund was missed by the per-entity queries.
#
# It stays even though the monitor runs seventeen times a day, because
# frequency is not coverage: a 2-day window sees today and yesterday however
# often it fires. What the sweep buys is the days a longer outage swallowed,
# and the re-filings of documents already archived -- those keep their original
# delivery date at the source, so only a query of the older day finds them.
SWEEP_SCHEDULE=10 5 * * *
SWEEP_ENABLED=true

# What a firing costs, since it is not what the narrower window suggests: this
# robot queries once per monitored entity, and one query covers the whole
# window, so a monitor firing costs about the same number of requests as a
# sweep firing -- roughly one per fund either way. The narrow window buys
# freshness and skips the audit; it does not buy fewer requests. Seventeen
# firings therefore cost seventeen times that, so keep an eye on the cadence if
# the watch list is long. Responses arrive in either ~0.3s or ~60s, and the
# loop is serial: a firing that lands while a run is still going is skipped,
# never queued.

# Which profile a container start runs: sweep, monitor or none. The sweep, by
# default -- a start usually follows a restart, an update or downtime, which is
# the gap case exactly, and the one the monitor's two days cannot see.
RUN_ON_START=sweep

# ------------------------------------------------------------ one-off overrides --

# The container's data_root and documents_root are fixed at /data and
# /documents by the image, so those two keys in your config.toml have no effect
# here -- the host side of the mapping is DOCUMENTS_PATH above.
#
# The override worth knowing about: the archive's file modes are absolute, not
# umask-relative, so a share that needs group write wants these rather than a
# umask setting.
#FII_WATCHER_FILES_FILE_MODE=0o664
#FII_WATCHER_FILES_DIRECTORY_MODE=0o775

# ------------------------------------------------------------------ retired --
#
# RUN_SCHEDULE named the only schedule there used to be, and what it named --
# the whole run, audit included -- is now the sweep, so it is still read as
# SWEEP_SCHEDULE and warned about. RUN_ON_START=true|false still means
# sweep|none. Set RUN_SCHEDULE and SWEEP_SCHEDULE to different expressions and
# the container refuses to start, rather than pick one.
