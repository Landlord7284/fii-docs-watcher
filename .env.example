# Deployment parameters for docker compose.
#
# The robot's own settings are NOT here -- they live in config.toml, which is
# mounted into the container, and which is the same file a native install uses.
# Copy config.example.toml to config.toml next to this file and edit that.
#
# Any single setting can still be overridden from here without touching the
# file, as FII_WATCHER_<SECTION>_<KEY>; see the bottom of this file for the one
# worth knowing about.

# ---------------------------------------------------------------- the image --

# Pin a release rather than tracking latest if you want updates to be a
# deliberate act: IMAGE_TAG=0.4.0
IMAGE_TAG=latest

# --------------------------------------------------------------- the archive --

# Where the archive lands on the host. This is the directory to share; the
# private state goes in a named volume instead and needs nothing from you.
DOCUMENTS_PATH=./documents
DATA_PATH=./data

# The uid and gid that own what the robot writes. Set these to whatever needs
# to read the share.
PUID=1000
PGID=1000

# -------------------------------------------------------------- the schedules --

# There are two run profiles, and a schedule for each. Schedules live here;
# how many days each profile covers lives in [discovery] in config.toml. They
# answer different questions -- how often to look, and how far back -- so a
# change of cadence must not read like a change of coverage.
#
# Enabling it requires the sweep: the sweep absorbs whatever the monitor misses, 
# so the scheduler refuses to start with the monitor on and the sweep off.
MONITOR_SCHEDULE=0 0,9-23 * * *
MONITOR_ENABLED=true

# The full sweep: once a day and early, covering [discovery].days and
# running the audit -- the global-listing cross-check that asks whether a
# document belonging to a monitored fund was missed by the per-entity queries.
#
SWEEP_SCHEDULE=0 8 * * *
SWEEP_ENABLED=true

# Which profile a container start runs: sweep, monitor or none. The sweep, by
# default -- a start usually follows a restart, an update or downtime, which is
# the gap case exactly, and the one the monitor's two days cannot see.
RUN_ON_START=sweep

# ------------------------------------------------------------ one-off overrides --

# The container's data_root and documents_root are fixed at /data and
# /documents by the image, so those two keys in your config.toml have no effect
# here -- the host side of the mapping is DOCUMENTS_PATH above.
#
# The override worth knowing about: the archive's file modes are absolute, not
# umask-relative, so a share that needs group write wants these rather than a
# umask setting.
#FII_WATCHER_FILES_FILE_MODE=0o664
#FII_WATCHER_FILES_DIRECTORY_MODE=0o775

